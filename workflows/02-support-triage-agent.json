    {
      "parameters": {
        "toolDescription": "Search the help-centre knowledge base. Returns up to 3 articles with id, title, body and a relevance score between 0 and 1.",
        "url": "={{ $env.HELPDESK_API_URL }}/kb/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "parametersQuery": {
          "values": [
            {
              "name": "q",
              "valueProvider": "modelRequired",
              "description": "a few keywords describing the customer's problem"
            }
          ]
        }
      },
