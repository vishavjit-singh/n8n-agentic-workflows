    {
      "parameters": {
        "toolDescription": "Look up an order by ID (format ORD-12345). Returns status, carrier, total and dates.",
        "url": "={{ $env.HELPDESK_API_URL }}/orders/{order_id}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "order_id",
              "description": "the order ID, e.g. ORD-10423",
              "type": "string"
            }
