{
  "name": "Support triage agent with human approval",
  "nodes": [
    {
      "parameters": {
        "content": "## Support triage agent\nA help-desk form posts each ticket to the webhook (answered with 202 at once). A tools agent searches the knowledge base, looks up the order when one is mentioned, and returns a structured triage with a draft reply.\n\nConfident, routine answers are emailed. Anything flagged, or below 0.7 confidence, goes to Slack for approval and the workflow **waits** for the reviewer's click (4 h limit). Every outcome is logged to a sheet.",
        "height": 300,
        "width": 600,
        "color": 7
      },
      "id": "ccc37bb8-5cc3-559b-8484-810bbbc2a2df",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -140
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-ticket",
        "responseMode": "onReceived",
        "options": {
          "responseCode": 202
        }
      },
      "id": "eeaec4b1-7805-5328-b132-d78fb84b4eff",
      "name": "Ticket webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "2c2bf4f8-fec2-54bb-ac3e-d8b2ca30937b"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "37171488-eeb2-5a6a-87f6-52c445760677",
              "name": "ticket_id",
              "value": "={{ $json.body.ticket_id }}",
              "type": "string"
            },
            {
              "id": "dfb3bf58-fef0-57b7-963d-602d3e2081f6",
              "name": "customer_email",
              "value": "={{ $json.body.email.trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "ed3559b5-e25e-57ae-aa2a-850faea42511",
              "name": "subject",
              "value": "={{ $json.body.subject }}",
              "type": "string"
            },
            {
              "id": "07fe4564-a226-5a98-81a4-bbf1ff9d7f0f",
              "name": "body",
              "value": "={{ $json.body.message }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "2ddea634-f618-5692-a7b7-c8b7a0f52229",
      "name": "Ticket fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Ticket {{ $json.ticket_id }} from {{ $json.customer_email }}\nSubject: {{ $json.subject }}\n\n{{ $json.body }}",
        "hasOutputParser": true,
        "options": {
          "maxIterations": 6,
          "systemMessage": "You triage customer support tickets for an online store. Always search the knowledge base before answering and cite the article IDs you used. If the ticket mentions an order ID (format ORD-12345), look it up. Draft a short, polite reply based only on the articles and the order record. Never promise refunds, credits or dates that the sources do not support. Set needs_human to true for refund requests, chargebacks, legal threats, account security issues, or when you are unsure. Set confidence to how well the sources answer the question."
        }
      },
      "id": "773675f9-e9c2-5878-a480-002e81e320c3",
      "name": "Triage agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        480,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
