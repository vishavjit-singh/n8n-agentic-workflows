    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"title\": \"ticket_triage\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"category\",\n    \"priority\",\n    \"confidence\",\n    \"needs_human\",\n    \"reason\",\n    \"draft_reply\",\n    \"cited_articles\",\n    \"order_id\"\n  ],\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"billing\",\n        \"shipping\",\n        \"account\",\n        \"technical\",\n        \"other\"\n      ]\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"normal\",\n        \"high\",\n        \"urgent\"\n      ]\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    },\n    \"needs_human\": {\n      \"type\": \"boolean\"\n    },\n    \"reason\": {\n      \"type\": \"string\",\n      \"maxLength\": 300\n    },\n    \"draft_reply\": {\n      \"type\": \"string\",\n      \"maxLength\": 1500\n    },\n    \"cited_articles\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"maxItems\": 3\n    },\n    \"order_id\": {\n      \"type\": \"string\",\n      \"description\": \"Order ID mentioned in the ticket, or empty\"\n    }\n  }\n}"
      },
      "id": "81f518bc-84d9-52b1-ac16-ad1e001c1dfb",
      "name": "Triage schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        980,
        580
      ]
    },
