        }
      },
      "id": "50d2401c-db1b-5e0a-bf9d-33eb4cb3225f",
      "name": "Ask for details",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        100
