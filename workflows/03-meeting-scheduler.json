{
  "name": "Meeting scheduler with calendar availability",
  "nodes": [
    {
      "parameters": {
        "content": "## Meeting scheduler\nTakes a plain-language request (\"45 minutes on Thursday afternoon to review the proposal\"). An LLM turns it into a duration and a time window with a fixed schema; Google Calendar returns the busy slots; a Code node finds the first free slot in working hours.\n\nIf one is free, the event is created and confirmed by email (201). Otherwise up to three alternatives are emailed (200). Vague requests get a 422 asking for a day.",
        "height": 280,
        "width": 600,
        "color": 7
      },
      "id": "685b8d04-4a75-54fe-8bda-5196153c85b1",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -140
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "schedule-meeting",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b7fbc8b7-b191-5251-9543-edb907025d41",
      "name": "Meeting request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "1aaa6080-15c7-592b-89ec-d5147010d9f7"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Current time: {{ $now.toISO() }}\nWorking hours: 09:00-17:00 UTC, Monday to Friday.\nRequester: {{ $json.body.requester_email }}\nRequest: {{ $json.body.request_text }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "Extract a meeting request. duration_minutes defaults to 30. window_start and window_end are ISO 8601 timestamps covering the day(s) and part of day the requester asked for (morning 09:00-12:00, afternoon 13:00-17:00, otherwise the whole working day). Resolve relative dates against the current time. If no day or date can be inferred, set needs_clarification to true. topic is a short subject line."
            }
          ]
        }
      },
      "id": "d46a3af9-bf73-53fc-a01a-a23ced9e3bab",
      "name": "Parse request",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        240,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0
        }
      },
      "id": "d43abf04-eeae-5112-b6ea-b96a3b75c1ea",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        140,
        560
      ],
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"title\": \"meeting_request\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"duration_minutes\",\n    \"window_start\",\n    \"window_end\",\n    \"topic\",\n    \"needs_clarification\"\n  ],\n  \"properties\": {\n    \"duration_minutes\": {\n      \"type\": \"integer\",\n      \"minimum\": 15,\n      \"maximum\": 120\n    },\n    \"window_start\": {\n      \"type\": \"string\",\n      \"description\": \"ISO 8601 start of the acceptable window\"\n    },\n    \"window_end\": {\n      \"type\": \"string\",\n      \"description\": \"ISO 8601 end of the acceptable window\"\n    },\n    \"topic\": {\n      \"type\": \"string\",\n      \"maxLength\": 120\n    },\n    \"needs_clarification\": {\n      \"type\": \"boolean\",\n      \"description\": \"true if no day or date can be inferred\"\n    }\n  }\n}"
      },
      "id": "bb0553b8-5643-52a3-a163-a24574e6e4c5",
      "name": "Meeting schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        340,
        560
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
