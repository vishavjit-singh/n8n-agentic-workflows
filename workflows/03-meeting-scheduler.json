    {
      "parameters": {
        "resource": "calendar",
        "operation": "availability",
        "calendar": {
          "__rl": true,
          "value": "={{ $env.SCHEDULING_CALENDAR_ID }}",
          "mode": "id"
        },
        "timeMin": "={{ $json.output.window_start }}",
        "timeMax": "={{ DateTime.fromISO($json.output.window_end).plus({ days: 3 }).toISO() }}",
        "options": {
          "outputFormat": "bookedSlots",
          "timezone": "UTC"
        }
      },
      "id": "c718e383-1a97-5f8a-8c40-7626b44288d2",
      "name": "Check calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.2,
      "position": [
        720,
        300
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": null,
          "name": "Google Calendar account"
        }
      },
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Busy slots come from the Google Calendar availability check; the window comes from the parser.\n// Slot arithmetic is done here, in code, rather than by the model.\nconst req = $('Parse request').first().json.output;\nconst busy = $input.all()\n  .map((i) => i.json)\n  .filter((b) => b.start && b.end)\n  .map((b) => [Date.parse(b.start), Date.parse(b.end)]);\nconst MIN = 60 * 1000;\nconst dur = req.duration_minutes * MIN;\nconst step = 30 * MIN;\nconst WORK_START = 9 * 60; // working hours in minutes after midnight (UTC; adjust for your calendar)\nconst WORK_END = 17 * 60;\n\nconst inHours = (t) => {\n  const d = new Date(t);\n  const day = d.getUTCDay();\n  const start = d.getUTCHours() * 60 + d.getUTCMinutes();\n  return day >= 1 && day <= 5 && start >= WORK_START && start + req.duration_minutes <= WORK_END;\n};\nconst isFree = (t) => busy.every(([s, e]) => t + dur <= s || t >= e);\nconst align = (t) => Math.ceil(t / step) * step;\nconst iso = (t) => new Date(t).toISOString();\n\nconst earliest = align(Math.max(Date.parse(req.window_start), Date.parse($now.toISO())));\nconst latest = Date.parse(req.window_end);\nlet slot = null;\nfor (let t = earliest; t + dur <= latest; t += step) {\n  if (inHours(t) && isFree(t)) { slot = t; break; }\n}\nconst alternatives = [];\nif (slot === null) {\n  const horizon = latest + 3 * 24 * 60 * MIN;\n  for (let t = align(Math.max(latest, earliest)); t + dur <= horizon && alternatives.length < 3; t += step) {\n    const spaced = alternatives.every((a) => Math.abs(Date.parse(a.start) - t) >= 3 * 60 * MIN);\n    if (inHours(t) && isFree(t) && spaced) alternatives.push({ start: iso(t), end: iso(t + dur) });\n  }\n}\nreturn [{\n  json: {\n    found: slot !== null,\n    start: slot === null ? '' : iso(slot),\n    end: slot === null ? '' : iso(slot + dur),\n    duration_minutes: req.duration_minutes,\n    topic: req.topic,\n    alternatives,\n    busy_slots_checked: busy.length,\n  },\n}];\n"
      },
