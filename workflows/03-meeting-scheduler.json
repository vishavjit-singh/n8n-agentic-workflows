              "id": "60355095-3d17-5f15-9e3f-c64e904a5aa4",
              "leftValue": "={{ $json.output.needs_clarification }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
