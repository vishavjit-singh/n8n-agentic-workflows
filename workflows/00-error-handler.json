{
  "name": "Shared error handler",
  "nodes": [
    {
      "parameters": {
        "content": "## Shared error handler\nThe other templates set `settings.errorWorkflow` to this workflow's ID. When one of their executions fails after its node retries, n8n starts this workflow with the error details.\n\nIt posts an alert to Slack and appends a row to an error-log sheet.\n\n**Needs:** Slack and Google Sheets credentials, `ERROR_LOG_SHEET_ID` env var.",
        "height": 220,
        "width": 520,
        "color": 7
      },
      "id": "a3ed17b3-852d-565d-afe9-e329101e1228",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        20
      ]
    },
    {
      "parameters": {},
      "id": "0614525f-a310-50a7-8bcb-b4e5f1e77c8c",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a2efdef3-37d1-5ffa-a095-9b0c5a2c904f",
              "name": "workflow_name",
              "value": "={{ $json.workflow.name }}",
              "type": "string"
            },
            {
              "id": "95e75cfa-abcb-5a71-9766-bbb97bed8f0f",
              "name": "workflow_id",
              "value": "={{ $json.workflow.id }}",
              "type": "string"
            },
            {
              "id": "98213af4-fd0d-5976-bd00-f5c39dfac209",
              "name": "failed_node",
              "value": "={{ $json.execution.lastNodeExecuted }}",
              "type": "string"
            },
            {
              "id": "271fa34c-b704-5eff-b486-09a5079c957a",
              "name": "error_message",
              "value": "={{ $json.execution.error.message }}",
              "type": "string"
            },
            {
              "id": "e7e0b4b5-50a7-537f-a6bc-c0939d4343f7",
              "name": "execution_id",
              "value": "={{ $json.execution.id }}",
              "type": "string"
            },
            {
              "id": "42761e35-ba41-5fa0-92ba-57fbcf68b682",
              "name": "execution_url",
              "value": "={{ $json.execution.url }}",
              "type": "string"
            },
            {
              "id": "6e81be46-6e83-55fe-9ef7-8821520d819f",
              "name": "occurred_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "cc39eda7-be3e-5da2-aa67-b2c2c5ecf984",
      "name": "Format alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#automation-alerts",
          "mode": "name"
        },
        "text": "=[n8n] *{{ $json.workflow_name }}* failed at node *{{ $json.failed_node }}*\n> {{ $json.error_message }}\nExecution {{ $json.execution_id }}: {{ $json.execution_url }}",
        "otherOptions": {}
      },
      "id": "77871518-5dc8-56b2-9f32-15757f6a6b0e",
      "name": "Alert Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        480,
        180
      ],
      "credentials": {
        "slackApi": {
          "id": null,
          "name": "Slack account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.ERROR_LOG_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Errors",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "occurred_at": "={{ $json.occurred_at }}",
            "workflow": "={{ $json.workflow_name }}",
            "node": "={{ $json.failed_node }}",
            "error": "={{ $json.error_message }}",
            "execution_url": "={{ $json.execution_url }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "occurred_at",
              "displayName": "occurred_at",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "workflow",
              "displayName": "workflow",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "node",
              "displayName": "node",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "error",
              "displayName": "error",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "execution_url",
              "displayName": "execution_url",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      },
      "id": "e4e230c1-4f8a-5fe4-9459-b12da1d4f221",
      "name": "Append to error log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        480,
        420
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": null,
          "name": "Google Sheets account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Format alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format alert": {
      "main": [
        [
          {
            "node": "Alert Slack",
            "type": "main",
            "index": 0
          },
          {
            "node": "Append to error log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "versionId": "ecb38a93-d567-59e0-b81f-73c5587b440a",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "id": "ErrHandlerShared",
  "tags": []
}
