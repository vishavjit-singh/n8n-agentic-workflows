    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"title\": \"lead_classification\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"intent\",\n    \"budget_band\",\n    \"urgency\",\n    \"summary\"\n  ],\n  \"properties\": {\n    \"intent\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"purchase\",\n        \"evaluation\",\n        \"support\",\n        \"not_a_fit\",\n        \"spam\"\n      ],\n      \"description\": \"What the sender wants\"\n    },\n    \"budget_band\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"none\",\n        \"under_5k\",\n        \"5k_25k\",\n        \"over_25k\"\n      ],\n      \"description\": \"Stated budget in USD; none if not stated\"\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"medium\",\n        \"high\"\n      ]\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"maxLength\": 200,\n      \"description\": \"One sentence for the sales team\"\n    }\n  }\n}"
      },
      "id": "2902fdab-0ef1-55db-b572-b6942d659905",
      "name": "Lead schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1300,
        560
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Deterministic scoring on top of the model's labels: the LLM classifies, the rules decide the tier.\nconst lead = $('Normalize lead').item.json;\nconst c = $json.output;\nconst intentPts = { purchase: 40, evaluation: 25, support: 5, not_a_fit: 0, spam: 0 }[c.intent] ?? 0;\nconst budgetPts = { over_25k: 30, '5k_25k': 20, under_5k: 8, none: 0 }[c.budget_band] ?? 0;\nconst urgencyPts = { high: 15, medium: 8, low: 0 }[c.urgency] ?? 0;\nconst size = lead.company_size;\nconst sizePts = size >= 200 ? 15 : size >= 20 ? 10 : size > 0 ? 4 : 0;\nlet score = intentPts + budgetPts + urgencyPts + sizePts;\nif (c.intent === 'spam' || c.intent === 'not_a_fit') score = Math.min(score, 10);\nconst tier = score >= 70 ? 'hot' : score >= 40 ? 'warm' : 'cold';\nreturn {\n  json: {\n    ...lead,\n    lead_id: lead.idempotency_key,\n    intent: c.intent,\n    budget_band: c.budget_band,\n    urgency: c.urgency,\n    summary: c.summary,\n    score,\n    tier,\n    qualified_at: $now.toISO(),\n  },\n};\n"
      },
