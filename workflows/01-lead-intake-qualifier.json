    {
      "parameters": {
        "promptType": "define",
        "text": "=Classify this inbound lead.\n\nName: {{ $('Normalize lead').item.json.name }}\nCompany: {{ $('Normalize lead').item.json.company }}\nCompany size: {{ $('Normalize lead').item.json.company_size }}\nBudget (USD): {{ $('Normalize lead').item.json.budget_usd }}\nSource: {{ $('Normalize lead').item.json.source }}\nMessage: {{ $('Normalize lead').item.json.message }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You qualify inbound leads for a small software consultancy. Use only the information in the lead. intent: purchase = wants to buy or get a quote; evaluation = researching or comparing; support = an existing customer with a problem; not_a_fit = students, job seekers, partnership pitches; spam = unsolicited offers. budget_band comes from the stated budget in USD (none if 0 or missing). urgency is high only for an explicit near deadline. Write a one-sentence summary for the sales team."
            }
          ]
        }
      },
      "id": "911c04a7-dfa0-5fe1-a728-7fbb6b5947c9",
      "name": "Classify lead",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        1200,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
