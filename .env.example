# Copy to .env (never commit .env). docker compose refuses to start until the first two are set.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
POSTGRES_PASSWORD=replace-with-a-password

N8N_VERSION=1.80.0
GENERIC_TIMEZONE=UTC
WEBHOOK_URL=http://localhost:5678/

# Read by the templates through $env (see docs/workflows/*.md)
HELPDESK_API_URL=http://mock-services:8080
METRICS_API_URL=http://mock-services:8080
CRM_SHEET_ID=
SUPPORT_LOG_SHEET_ID=
ERROR_LOG_SHEET_ID=
SCHEDULING_CALENDAR_ID=primary

# Optional: make the mock API require X-API-Key (match it in the "Helpdesk API key" / "Metrics API key" credentials)
MOCK_API_KEY=
